NODE_ENV=development
PORT=3000
# Comma-separated browser origins (Next.js UI). In development, private LAN IPs are also allowed.
CORS_ORIGIN=http://localhost

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=bidder_platform

# true only for local development. Use migrations in shared/production DBs.
DB_SYNCHRONIZE=false

SWAGGER_ENABLED=true

JWT_SECRET=change-me-use-at-least-16-chars
JWT_EXPIRES_IN=1d

# BidderPlatform internal Talyn ingest key (not Talyn native auth).
# Leave empty to keep machine ingest fail-closed.
TALYN_INGEST_API_KEY=

# Local upload directory (member avatars). Relative to the API working directory.
UPLOAD_DIR=uploads

# JiraCoders (Applications table). Token is sent as Authorization: Bearer.
JIRACODERS_API_BASE_URL=https://api.jiracoders.com
JIRACODERS_API_TOKEN=

# Public site origin (calendar connect links + OAuth callbacks via /api/...).
APP_PUBLIC_URL=http://localhost

# Google Calendar (Interviews). Redirect URI: {APP_PUBLIC_URL}/api/calendar/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Calendar (Interviews). Redirect URI: {APP_PUBLIC_URL}/api/calendar/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
